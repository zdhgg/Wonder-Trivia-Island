# Development ports
HOST=0.0.0.0
PORT=3008
API_PORT=8008

# Optional database override
# TRIVIA_DB_PATH=backend/data/trivia.db

# Optional: allow browser access from specific cross-origin frontends.
# Leave blank for the default same-origin deployment model.
# Multiple origins can be comma-separated.
# CORS_ORIGIN=http://localhost:3008,https://example.com

# Optional admin key for the management surface (import / catalog mutation /
# proposal review / teaching demo review).
# 管理面语义：本机（真实 socket loopback）访问不需要口令；非本机访问必须带
# x-admin-key，否则拒绝。判定完全忽略 X-Forwarded-For 等请求头。
# 如果前端不是由本仓库的 Vite dev / preview server 提供（例如门户系统、nginx、
# 静态托管 dist），Vite 边缘守卫不会生效，此时这个 Key 就是唯一的兜底，必须设置。
# ADMIN_IMPORT_KEY=change-me

# Optional AI runtime defaults
# 用于 AI 出题 / 点评 / 首页欢迎语 / 语音播报。
# 教学演示（Teaching Demo）不使用这些配置：demo 由外部 Harness 生成并经
# External AI Gateway 提交，本系统只做校验、保存和渲染，因此不需要任何模型 Key。
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_QUESTION_MODEL=gpt-5.4-mini
# OPENAI_REVIEW_MODEL=gpt-5.4-mini
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=coral
# OPENAI_TTS_SPEED=1
